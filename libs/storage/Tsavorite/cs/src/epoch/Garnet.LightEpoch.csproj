<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../../../../../Garnet.snk</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Tsavorite.core</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <WarningsAsErrors>;NU1605</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tsavorite.core" Key="" />
    <InternalsVisibleTo Include="Garnet.LightEpoch.test" Key="" />
    <InternalsVisibleTo Include="LightEpochLitmus" Key="" />
    <InternalsVisibleTo Include="Tsavorite.test" Key="" />
    <InternalsVisibleTo Include="Garnet.test" Key="" />
  </ItemGroup>
</Project>
