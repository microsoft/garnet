<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
	<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- The SDK force-disables composite R2R for framework-dependent publish, so set it after that default
       is applied. Composite puts all app assemblies in a single version bubble, which keeps cross-assembly
       inlining of hot paths (e.g. Tsavorite.core calls into Garnet.shared's LightEpoch) in the R2R image. -->
  <Target Name="EnableCompositeReadyToRun" BeforeTargets="_PrepareForReadyToRunCompilation">
    <PropertyGroup>
      <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    </PropertyGroup>
  </Target>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
	<PublishDir>bin\Release\net8.0\publish\win-arm64\</PublishDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
	<PublishDir>bin\Release\net10.0\publish\win-arm64\</PublishDir>
  </PropertyGroup>
</Project>